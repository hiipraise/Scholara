# ── Scholara Backend — copy to .env and fill in ──────────────────────────

APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=scholara_db

# ── AI Provider (choose one free option) ────────────────────────────────
# "groq"   → free at https://console.groq.com  (recommended, no billing)
# "gemini" → free at https://aistudio.google.com/apikey
# "mock"   → no key needed, returns placeholder questions (dev/testing)

AI_PROVIDER=groq

# Groq (free tier — no credit card required)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (free tier — 15 RPM, 1M tokens/day)
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-1.5-flash

# SuperAdmin
SUPERADMIN_EMAIL=info.praisechinedu@gmail.com

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

ENABLE_AUDIT_LOG=False
AUDIT_LOG_FILE="logs/audit.log"