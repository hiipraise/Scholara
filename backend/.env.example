# ── Scholara Backend — copy to .env and fill in ──────────────────────────

APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=scholara_db

# ── AI Provider — Groq (single provider) ────────────────────────────────
# Free key at https://console.groq.com — no credit card, no billing.
# No fallback provider and no mock mode: a provider failure raises so the job
# can retry the failed pipeline stage.
GROQ_API_KEY=gsk_your_groq_key_here
# Current supported model. Retired llama-3.1-70b-* models are not used.
GROQ_MODEL=openai/gpt-oss-20b

# SuperAdmin
SUPERADMIN_EMAIL=info.praisechinedu@gmail.com

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Optional additional Host headers accepted by TrustedHostMiddleware.
TRUSTED_HOSTS=[]

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Background PDF processing — a stalled job past this deadline is requeued.
PDF_PROCESSING_TIMEOUT_SECONDS=300

ENABLE_AUDIT_LOG=False
AUDIT_LOG_FILE="logs/audit.log"