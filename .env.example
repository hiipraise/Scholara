# ─────────────────────────────────────────────────────────────────────────────
# Scholara — Environment Configuration Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: Secret Key ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 characters. Must be set — the app refuses to start without it.
SECRET_KEY=

# ── REQUIRED: Signup Invite Code ─────────────────────────────────────────────
# Users must supply this exact code to create an account.
# Change this value and redeploy to rotate — no code changes needed.
SIGNUP_INVITE_CODE=

# ── REQUIRED: SuperAdmin Email ───────────────────────────────────────────────
# The email that gets the superadmin role on signup.
# Must be set — the app refuses to start without it.
SUPERADMIN_EMAIL=
# ── SuperAdmin Default Level & Semester (optional) ────────────────────────────
# Used when creating the superadmin account via seed.py.
SUPERADMIN_LEVEL=100L
SUPERADMIN_SEMESTER=1

# ── Application Environment ──────────────────────────────────────────────────
# Options: development | production
# In production, Swagger docs are disabled and more security defaults apply.
APP_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Use MongoDB Atlas free tier connection string in production:
#   mongodb+srv://user:password@cluster.mongodb.net/scholara_db?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=scholara_db

# ── AI Provider ──────────────────────────────────────────────────────────────
# Options: groq | gemini | mock
# Get free keys at:
#   Groq:   https://console.groq.com
#   Gemini: https://aistudio.google.com/apikey
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Allowed CORS Origins (comma-separated) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional additional Host headers accepted by TrustedHostMiddleware.
# Render hosts are allowed by default, but custom API domains should be listed here.
TRUSTED_HOSTS=

# ── JWT Configuration ────────────────────────────────────────────────────────
# Access tokens: short-lived (default 15 minutes)
# Refresh tokens: longer-lived (default 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ────────────────────────────────────────────────────────────
# General API: requests per minute per IP
# Auth endpoints: requests per minute per email
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# ── Security & Logging ───────────────────────────────────────────────────────
ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=true
ENABLE_REQUEST_LOGGING=true
LOG_LEVEL=INFO

# ── Audit Logging (optional, file-based) ─────────────────────────────────────
ENABLE_AUDIT_LOG=false
AUDIT_LOG_FILE=logs/audit.log

# ── File Upload ──────────────────────────────────────────────────────────────
# Max file size for PDF uploads (MB)
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
